msgid "Waiting for authorization..."
msgstr "承認を待っています..."

#: src/mainuan_recursos/packagekit.py:199
#, python-brace-format
msgid "Operation canceled or not completed (code {code})."
msgstr "操作がキャンセルされたか、完了しませんでした (コード {code})。"

