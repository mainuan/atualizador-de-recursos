msgid "Operation canceled or not completed (code {code})."
msgstr "A művelet megszakadt vagy nem fejeződött be (kód: {code})."

#: src/mainuan_recursos/packagekit.py:201
msgid "Transaction ended without confirmation of completion."
msgstr "A tranzakció a befejezés megerősítése nélkül ért véget."

