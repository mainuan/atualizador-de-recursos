msgid "The PackageKit service was disconnected."
msgstr "A PackageKit szolgáltatás kapcsolata megszakadt."

#: src/mainuan_recursos/packagekit.py:211
msgid "The PackageKit query timed out."
msgstr "A PackageKit-lekérdezés túllépte az időkorlátot."

#: src/mainuan_recursos/packagekit.py:216
#, python-brace-format
msgid "{error} The result may be partial; check the packages again."
msgstr "{error} Az eredmény részleges lehet; ellenőrizze újra a csomagokat."

