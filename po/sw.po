msgctxt "package status"
msgid "Update"
msgstr "Sasisha"

#: src/mainuan_recursos/packages.py:18
msgctxt "package status"
msgid "Already received"
msgstr "Tayari imepokelewa"

#: src/mainuan_recursos/packages.py:103
msgid "APT candidate differs from the approved version"
msgstr "Toleo pendekezwa la APT linatofautiana na toleo lililoidhinishwa"

#: src/mainuan_recursos/packages.py:105 src/mainuan_recursos/packages.py:115
msgid "Untrusted source"
msgstr "Chanzo kisichoaminika"

#: src/mainuan_recursos/packages.py:107
msgid "Integrity of the approved package does not match"
msgstr "Uadilifu wa kifurushi kilichoidhinishwa haulingani"

#: src/mainuan_recursos/packages.py:111
msgid "Required version unavailable"
msgstr "Toleo linalohitajika halipatikani"

#: src/mainuan_recursos/packages.py:113
msgid "No safe update available"
msgstr "Hakuna sasisho salama linalopatikana"

#: src/mainuan_recursos/packages.py:125
msgid "PackageKit returned an invalid identifier."
msgstr "PackageKit ilirudisha kitambulisho kisicho sahihi."

#: src/mainuan_recursos/packages.py:139
msgid ""
"The operation requires removal, reinstallation, downgrade or a disallowed "
"effect."
msgstr ""
"Operesheni inahitaji kuondoa, kusakinisha upya, kushusha toleo au athari "
"isiyoruhusiwa."

#: src/mainuan_recursos/packages.py:143
#, python-brace-format
msgid "Could not validate the source of {name}."
msgstr "Haikuweza kuthibitisha chanzo cha {name}."

#: src/mainuan_recursos/packages.py:147
#, python-brace-format
msgid "The package {name} does not have a trusted source."
msgstr "Kifurushi {name} hakina chanzo kinachoaminika."

#: src/mainuan_recursos/packages.py:151
#, python-brace-format
msgid ""
"The integrity of the approved package {name} has changed. Check the "
"repositories."
msgstr ""
"Uadilifu wa kifurushi kilichoidhinishwa {name} umebadilika. Kagua hazina."

#: src/mainuan_recursos/packages.py:153
#, python-brace-format
msgid "The package {name} is held by the administrator."
msgstr "Kifurushi {name} kimeshikiliwa na msimamizi."

#: src/mainuan_recursos/packages.py:155
#, python-brace-format
msgid "The package {name} has an incomplete configuration."
msgstr "Kifurushi {name} kina usanidi usiokamilika."

#: src/mainuan_recursos/packages.py:158
#, python-brace-format
msgid "Reinstallation or downgrade of {name} blocked."
msgstr "Kusakinisha upya au kushusha toleo la {name} kumezuiwa."

#: src/mainuan_recursos/packages.py:161
msgid "The simulation did not confirm all requested packages."
msgstr "Uigaji haukuthibitisha vifurushi vyote vilivyoombwa."

#: src/mainuan_recursos/repository.py:27
msgid "Local cache exceeds the size limit."
msgstr "Akiba ya ndani inazidi kikomo cha ukubwa."

#: src/mainuan_recursos/repository.py:45
msgid "Old or changed catalog; the valid cache was preserved."
msgstr "Katalogi ya zamani au iliyobadilishwa; akiba halali imehifadhiwa."

#: src/mainuan_recursos/state.py:54
msgid "Local state too large."
msgstr "Hali ya ndani ni kubwa mno."

#: src/mainuan_recursos/state.py:56 src/mainuan_recursos/state.py:58
#: src/mainuan_recursos/state.py:66
msgid "Invalid state."
msgstr "Hali si sahihi."

#: src/mainuan_recursos/state.py:61
msgid "Invalid sequence/digest."
msgstr "Mfuatano/muhtasari si sahihi."

#: src/mainuan_recursos/state.py:63
msgid "Invalid release."
msgstr "Toleo si sahihi."

#: src/mainuan_recursos/state.py:64
msgid "Incomplete state."
msgstr "Hali haijakamilika."

#: src/mainuan_recursos/state.py:68 src/mainuan_recursos/state.py:71
msgid "Invalid deadline."
msgstr "Tarehe ya mwisho si sahihi."

#: src/mainuan_recursos/state.py:74
msgid "The local state is damaged. Preserve the file before recovering it."
msgstr "Hali ya ndani imeharibika. Hifadhi faili kabla ya kuirejesha."

#: src/mainuan_recursos/state.py:104
msgid "Old catalog or content changed without increasing the sequence."
msgstr "Katalogi ya zamani au maudhui yamebadilishwa bila kuongeza mfuatano."
